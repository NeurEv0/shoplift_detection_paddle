venv/

shoplift/configs/env.local.yml
shoplift/configs/pipeline.local.yml
src/PaddleDetection-release-2.9/deploy/fastdeploy/serving/models/
data/

# Keep source package modules tracked; ignore only Python byproducts inside them.
!shoplift/models/
!shoplift/models/**
/shoplift/models/**/__pycache__/
/shoplift/models/**/*.py[cod]

outputs/

# Large media/model artifacts are local or reproducible.
*.mp4
*.mpg
*.mpeg
*.avi
*.mov
*.mkv
*.pdparams
*.pdmodel
*.pdiparams
*.pdiparams.info
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.trt

# Root model zoo: keep lightweight documentation, ignore downloaded weights.
/models/*
!/models/pretrained/
/models/pretrained/*
!/models/pretrained/person_attribute/
/models/pretrained/person_attribute/*
!/models/pretrained/person_attribute/README.md
!/models/shoplift/
/models/shoplift/*
!/models/shoplift/person_attribute/
/models/shoplift/person_attribute/*
!/models/shoplift/person_attribute/README.md
!/models/shoplift/item_container/
/models/shoplift/item_container/*
!/models/shoplift/item_container/README.md

# Datasets: keep docs/specs/examples, ignore raw media and generated splits.
/datasets/*
!/datasets/person_attribute/
/datasets/person_attribute/*
!/datasets/person_attribute/README.md
!/datasets/person_attribute/splits/
/datasets/person_attribute/splits/*
!/datasets/person_attribute/splits/train.example.csv
!/datasets/container_det/
/datasets/container_det/*
!/datasets/container_det/README.md
!/datasets/container_det/container_labeling_spec.md
!/datasets/container_det/label_list.txt
!/datasets/container_det/label_studio_config.xml
